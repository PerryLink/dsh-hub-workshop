{
	"$schema": "node_modules/wrangler/config-schema.json",
	"name": "dsh-hub",
	"main": "worker/public.js",
	"compatibility_date": "2026-08-05",
	"workers_dev": false,
	"preview_urls": false,
	"assets": {
		"directory": "./.public-site",
		"binding": "ASSETS",
		"run_worker_first": true,
		"html_handling": "auto-trailing-slash",
		"not_found_handling": "none"
	}
}
